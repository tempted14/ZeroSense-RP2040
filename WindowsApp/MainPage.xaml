<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RainbowRecoil.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="MainPage_Loaded"
    Unloaded="MainPage_Unloaded">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- Full desktop shell -->
        <Grid x:Name="FullShell">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#0A0A0A"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="196,*,Auto" Padding="14,0,18,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="7" Background="#080808"
                                BorderBrush="#292929" BorderThickness="1">
                            <Image Source="ms-appx:///Assets/zerosense-mark.png"
                                   Width="27" Height="27" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="ZEROSENSE"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="14" FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="CurrentPageTitle"
                               Grid.Column="1"
                               Text="Overview"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Border Padding="9,5" CornerRadius="6" Background="#101010"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse x:Name="TopConnectionDot" Width="6" Height="6" Fill="#626262"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="TopConnectionText" Text="Offline" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="9,5" CornerRadius="6" Background="#101010"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                            <TextBlock x:Name="TopArmStatusText" Text="Output safe" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                        <Border Padding="9,5" CornerRadius="6" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock x:Name="TopOverlayShortcutText" Text="F8  Overlay" FontSize="11"
                                       Foreground="#C9BDFF" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="196,*">
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Padding="12,16,12,14" RowDefinitions="Auto,*,Auto">
                        <StackPanel Spacing="5">
                            <TextBlock Text="WORKSPACE" Margin="10,0,0,7" FontSize="10"
                                       FontWeight="SemiBold" Foreground="#5F5F5F" CharacterSpacing="100" />

                            <Button x:Name="OverviewNavButton" Style="{StaticResource NavigationButtonStyle}"
                                    Click="NavigationButton_Click" Tag="Overview">
                                <Grid ColumnDefinitions="3,24,*" ColumnSpacing="9">
                                    <Border x:Name="OverviewNavIndicator" Background="{StaticResource AccentBrush}"
                                            CornerRadius="2" />
                                    <FontIcon Grid.Column="1" Glyph="&#xE80F;" FontSize="15" />
                                    <TextBlock Grid.Column="2" Text="Overview" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="DetectionNavButton" Style="{StaticResource NavigationButtonStyle}"
                                    Click="NavigationButton_Click" Tag="Detection">
                                <Grid ColumnDefinitions="3,24,*" ColumnSpacing="9">
                                    <Border x:Name="DetectionNavIndicator" Background="{StaticResource AccentBrush}"
                                            CornerRadius="2" Opacity="0" />
                                    <FontIcon Grid.Column="1" Glyph="&#xE7C1;" FontSize="15" />
                                    <TextBlock Grid.Column="2" Text="Detection" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="CalibrationNavButton" Style="{StaticResource NavigationButtonStyle}"
                                    Click="NavigationButton_Click" Tag="Calibration">
                                <Grid ColumnDefinitions="3,24,*" ColumnSpacing="9">
                                    <Border x:Name="CalibrationNavIndicator" Background="{StaticResource AccentBrush}"
                                            CornerRadius="2" Opacity="0" />
                                    <FontIcon Grid.Column="1" Glyph="&#xE9E9;" FontSize="15" />
                                    <TextBlock Grid.Column="2" Text="Calibration" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="DeviceNavButton" Style="{StaticResource NavigationButtonStyle}"
                                    Click="NavigationButton_Click" Tag="Device">
                                <Grid ColumnDefinitions="3,24,*" ColumnSpacing="9">
                                    <Border x:Name="DeviceNavIndicator" Background="{StaticResource AccentBrush}"
                                            CornerRadius="2" Opacity="0" />
                                    <FontIcon Grid.Column="1" Glyph="&#xE88E;" FontSize="15" />
                                    <TextBlock Grid.Column="2" Text="Device" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="InstallationNavButton" Style="{StaticResource NavigationButtonStyle}"
                                    Click="NavigationButton_Click" Tag="Installation">
                                <Grid ColumnDefinitions="3,24,*" ColumnSpacing="9">
                                    <Border x:Name="InstallationNavIndicator" Background="{StaticResource AccentBrush}"
                                            CornerRadius="2" Opacity="0" />
                                    <FontIcon Grid.Column="1" Glyph="&#xE82D;" FontSize="15" />
                                    <TextBlock Grid.Column="2" Text="Installation" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2" Padding="11" CornerRadius="8" Background="#101010"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#B7A9FF" CharacterSpacing="80" />
                                </StackPanel>
                                <TextBlock x:Name="SidebarOverlayHint" Text="Press F8 for overlay"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
                    <!-- Overview -->
                    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1120" Padding="28,24,28,30" HorizontalAlignment="Center">
                            <Grid.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="14" />
                                </TransitionCollection>
                            </Grid.Transitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="ZeroSense control center" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Your active loadout, hardware link, and output state at a glance."
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <Button x:Name="ConnectButton" Grid.Column="1" Content="Scan for device"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Center" Click="ConnectButton_Click" />
                            </Grid>

                            <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="#151515">
                                        <FontIcon Glyph="&#xE88E;" FontSize="16" Foreground="#B9B9B9"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse x:Name="ConnectionStatusDot" Width="7" Height="7" Fill="#626262"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="ConnectionStatusText" Text="Device not connected"
                                                       FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock x:Name="DeviceMessageText"
                                                   Text="Connect a flashed RP2040 or RP2350 and scan for its serial interface."
                                                   Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ArmToggle" Grid.Column="2" Header="ARM OUTPUT"
                                                  IsEnabled="False" Toggled="ArmToggle_Toggled" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="3*,2*" ColumnSpacing="14">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Active loadout" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Search or select an operator and compatible weapon."
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="8,4" CornerRadius="5"
                                                    Background="{StaticResource AccentSoftBrush}">
                                                <TextBlock Text="LIVE PROFILE" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="#B9AAFF" CharacterSpacing="100" />
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="OPERATOR" Style="{StaticResource LabelStyle}" />
                                                <ComboBox x:Name="OperatorSelector" HorizontalAlignment="Stretch"
                                                          DisplayMemberPath="OperatorName"
                                                          IsEditable="True" IsTextSearchEnabled="True"
                                                          SelectionChanged="OperatorSelector_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="WEAPON" Style="{StaticResource LabelStyle}" />
                                                <ComboBox x:Name="WeaponSelector" HorizontalAlignment="Stretch"
                                                          DisplayMemberPath="Name"
                                                          IsEditable="True" IsTextSearchEnabled="True"
                                                          SelectionChanged="WeaponSelector_SelectionChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Padding="12" CornerRadius="7" Background="#0B0B0B"
                                                BorderBrush="#1D1D1D" BorderThickness="1">
                                            <StackPanel Spacing="5">
                                                <TextBlock x:Name="WeaponSlotText" Text="PRIMARY SLOT"
                                                           Style="{StaticResource LabelStyle}" />
                                                <TextBlock x:Name="ProfileDescriptionText"
                                                           Style="{StaticResource MutedTextStyle}" />
                                                <TextBlock x:Name="AttachmentNoteText" Foreground="#D8B45A"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Visibility="Collapsed" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="14">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="11">
                                            <TextBlock Text="Output model" Style="{StaticResource SectionTitleStyle}" />
                                            <ComboBox x:Name="CompensationModeSelector" HorizontalAlignment="Stretch"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectionChanged="CompensationModeSelector_SelectionChanged" />
                                            <TextBlock x:Name="ModeDescriptionText"
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <Border Padding="10" CornerRadius="7"
                                                    Background="#0B0B0B"
                                                    BorderBrush="{StaticResource StrokeBrush}"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="*,110,Auto" ColumnSpacing="9">
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="PER-WEAPON OUTPUT STRENGTH"
                                                                   Style="{StaticResource LabelStyle}" />
                                                        <TextBlock x:Name="WeaponStrengthStatusText"
                                                                   Text="1.00× preserves the profile"
                                                                   Style="{StaticResource MutedTextStyle}" />
                                                    </StackPanel>
                                                    <NumberBox x:Name="WeaponStrengthBox" Grid.Column="1"
                                                               Minimum="0.25" Maximum="2" Value="1"
                                                               SmallChange="0.05" SpinButtonPlacementMode="Compact"
                                                               VerticalAlignment="Center"
                                                               ValueChanged="WeaponStrength_ValueChanged" />
                                                    <Button x:Name="ResetWeaponStrengthButton" Grid.Column="2"
                                                            Content="Reset" VerticalAlignment="Center"
                                                            Click="ResetWeaponStrength_Click" />
                                                </Grid>
                                            </Border>
                                            <Border x:Name="ExperimentalTuningPanel"
                                                    Visibility="Collapsed"
                                                    Padding="10" CornerRadius="7"
                                                    Background="#0B0B0B"
                                                    BorderBrush="#2A2148" BorderThickness="1">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="EXPERIMENTAL PER-WEAPON TUNING"
                                                                       Style="{StaticResource LabelStyle}" />
                                                            <TextBlock Text="1.00 preserves the standard pattern. Tune in small steps."
                                                                       Style="{StaticResource MutedTextStyle}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Reset weapon"
                                                                Click="ResetExperimentalTuning_Click" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"
                                                          ColumnSpacing="7" RowSpacing="7">
                                                        <NumberBox x:Name="ExperimentalFirstShotBox"
                                                                   Header="FIRST" Minimum="0.25" Maximum="2"
                                                                   SmallChange="0.05" Value="1"
                                                                   SpinButtonPlacementMode="Compact"
                                                                   ValueChanged="ExperimentalTuning_ValueChanged" />
                                                        <NumberBox x:Name="ExperimentalEarlyBox" Grid.Column="1"
                                                                   Header="EARLY" Minimum="0.25" Maximum="2"
                                                                   SmallChange="0.05" Value="1"
                                                                   SpinButtonPlacementMode="Compact"
                                                                   ValueChanged="ExperimentalTuning_ValueChanged" />
                                                        <NumberBox x:Name="ExperimentalMidBox" Grid.Column="2"
                                                                   Header="MID" Minimum="0.25" Maximum="2"
                                                                   SmallChange="0.05" Value="1"
                                                                   SpinButtonPlacementMode="Compact"
                                                                   ValueChanged="ExperimentalTuning_ValueChanged" />
                                                        <NumberBox x:Name="ExperimentalLateBox" Grid.Row="1"
                                                                   Header="LATE" Minimum="0.25" Maximum="2"
                                                                   SmallChange="0.05" Value="1"
                                                                   SpinButtonPlacementMode="Compact"
                                                                   ValueChanged="ExperimentalTuning_ValueChanged" />
                                                        <NumberBox x:Name="ExperimentalHorizontalBox" Grid.Row="1" Grid.Column="1"
                                                                   Header="HORIZONTAL" Minimum="0" Maximum="2"
                                                                   SmallChange="0.05" Value="1"
                                                                   SpinButtonPlacementMode="Compact"
                                                                   ValueChanged="ExperimentalTuning_ValueChanged" />
                                                    </Grid>
                                                    <TextBlock x:Name="ExperimentalTuningStatusText"
                                                               Foreground="#B9AAFF" FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <ToggleSwitch x:Name="RapidFireToggle"
                                                          Header="Rapid fire for semi-automatic weapons"
                                                          IsOn="True"
                                                          Toggled="RapidFireToggle_Toggled" />
                                            <TextBlock x:Name="RapidFireStatusText"
                                                       Text="Select a semi-automatic profile to see its rate."
                                                       Foreground="#B9AAFF" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Operator detection" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock x:Name="OverviewDetectionStatusText" Text="Disabled"
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Configure"
                                                    Click="OpenDetectionPage_Click" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- Detection and overlay settings -->
                    <ScrollViewer x:Name="DetectionPage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1120" Padding="28,24,28,30" HorizontalAlignment="Center">
                            <Grid.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="14" />
                                </TransitionCollection>
                            </Grid.Transitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Detection &amp; overlay" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Local, in-memory screen recognition with explicit controls."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="3*,2*" ColumnSpacing="14">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Operator recognition" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="OCR checks only the selected screen region; no image is saved."
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="9,6" CornerRadius="6" Background="#0B0B0B"
                                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Ellipse x:Name="DetectionStatusDot" Width="6" Height="6" Fill="#626262"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock x:Name="DetectionStatusText" Text="Idle" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="DETECTION MODE" Style="{StaticResource LabelStyle}" />
                                            <ComboBox x:Name="DetectionModeSelector" HorizontalAlignment="Stretch"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectionChanged="DetectionModeSelector_SelectionChanged" />
                                        </StackPanel>

                                        <ToggleSwitch x:Name="AutoApplyDetectionToggle"
                                                      Header="Automatically apply confident matches"
                                                      Toggled="DetectionSetting_Changed" />

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="DetectionDetailText"
                                                           Text="Choose a mode, then test recognition while the operator name is visible."
                                                           Style="{StaticResource MutedTextStyle}" />
                                                <TextBlock x:Name="RecognizedTextPreview" Text=""
                                                           FontFamily="Consolas" FontSize="10" Foreground="#606060"
                                                           TextTrimming="CharacterEllipsis" MaxLines="2" />
                                            </StackPanel>
                                            <Button x:Name="CaptureNowButton" Grid.Column="1" Content="Detect now"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="CaptureNowButton_Click" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="13">
                                        <TextBlock Text="Capture keybind" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Used in Keybind mode. Mouse buttons and function keys are supported."
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="MODIFIER" Style="{StaticResource LabelStyle}" />
                                                <ComboBox x:Name="DetectionModifierSelector"
                                                          SelectionChanged="DetectionHotkey_Changed" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="KEY" Style="{StaticResource LabelStyle}" />
                                                <ComboBox x:Name="DetectionKeySelector"
                                                          SelectionChanged="DetectionHotkey_Changed" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Padding="10" CornerRadius="6" Background="#0B0B0B">
                                            <TextBlock x:Name="DetectionHotkeyPreview" Text="Shift + M1"
                                                       HorizontalAlignment="Center" FontSize="12"
                                                       Foreground="#C3C3C3" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="3*,2*" ColumnSpacing="14">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="13">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Recognition area" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Percent of the virtual desktop. The default scans the upper 55%."
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                            <TextBlock x:Name="ConfidenceValueText" Grid.Column="1" Text="74% minimum"
                                                       FontSize="11" Foreground="#B9AAFF" />
                                        </Grid>

                                        <Slider x:Name="ConfidenceSlider" Minimum="55" Maximum="100" StepFrequency="1"
                                                ValueChanged="ConfidenceSlider_ValueChanged" />

                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="LEFT %" Style="{StaticResource LabelStyle}" />
                                                <NumberBox x:Name="DetectionRegionXBox" Minimum="0" Maximum="95"
                                                           SmallChange="1" SpinButtonPlacementMode="Compact"
                                                           ValueChanged="DetectionRegion_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="TOP %" Style="{StaticResource LabelStyle}" />
                                                <NumberBox x:Name="DetectionRegionYBox" Minimum="0" Maximum="95"
                                                           SmallChange="1" SpinButtonPlacementMode="Compact"
                                                           ValueChanged="DetectionRegion_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="6">
                                                <TextBlock Text="WIDTH %" Style="{StaticResource LabelStyle}" />
                                                <NumberBox x:Name="DetectionRegionWidthBox" Minimum="5" Maximum="100"
                                                           SmallChange="1" SpinButtonPlacementMode="Compact"
                                                           ValueChanged="DetectionRegion_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="6">
                                                <TextBlock Text="HEIGHT %" Style="{StaticResource LabelStyle}" />
                                                <NumberBox x:Name="DetectionRegionHeightBox" Minimum="5" Maximum="100"
                                                           SmallChange="1" SpinButtonPlacementMode="Compact"
                                                           ValueChanged="DetectionRegion_ValueChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="13">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="In-game overlay" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Compact, always-on-top access to the active profile."
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="OverlayEnabledToggle" Grid.Column="1"
                                                          Toggled="OverlaySetting_Changed" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="MODIFIER" Style="{StaticResource LabelStyle}" />
                                                <ComboBox x:Name="OverlayModifierSelector"
                                                          SelectionChanged="OverlayHotkey_Changed" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="KEY" Style="{StaticResource LabelStyle}" />
                                                <ComboBox x:Name="OverlayKeySelector"
                                                          SelectionChanged="OverlayHotkey_Changed" />
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="ShowOverlayButton" Content="Open overlay now"
                                                Click="ShowOverlayButton_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Loadout recognition &amp; slot switching"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="OCR reads both named weapon cards on the operator Loadout screen. The 1 and 2 shortcuts select the remembered primary or secondary profile in-round."
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="9,6" CornerRadius="6" Background="#0B0B0B"
                                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Ellipse x:Name="WeaponDetectionStatusDot" Width="6" Height="6" Fill="#626262"
                                                         VerticalAlignment="Center" />
                                                <TextBlock x:Name="WeaponDetectionStatusText" Text="Disabled" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="2*,3*" ColumnSpacing="18">
                                        <StackPanel Spacing="10">
                                            <ToggleSwitch x:Name="WeaponDetectionToggle"
                                                          Header="Enable Loadout-screen weapon OCR"
                                                          Toggled="WeaponDetectionSetting_Changed" />
                                            <ToggleSwitch x:Name="AutoApplyWeaponDetectionToggle"
                                                          Header="Automatically apply confident weapon matches"
                                                          Toggled="WeaponDetectionSetting_Changed" />
                                            <ToggleSwitch x:Name="WeaponSlotHotkeysToggle"
                                                          Header="Use 1 for primary and 2 for secondary"
                                                          Toggled="WeaponDetectionSetting_Changed" />
                                            <TextBlock Text="Slot shortcuts run only while Rainbow Six is the foreground app, so typing elsewhere cannot change the loadout."
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="LOADOUT CARDS AREA (PRIMARY TOP, SECONDARY BOTTOM)"
                                                           Style="{StaticResource LabelStyle}" />
                                                <TextBlock x:Name="WeaponConfidenceValueText" Grid.Column="1"
                                                           Text="72% minimum" FontSize="11" Foreground="#B9AAFF" />
                                            </Grid>
                                            <Slider x:Name="WeaponConfidenceSlider" Minimum="55" Maximum="100"
                                                    StepFrequency="1"
                                                    ValueChanged="WeaponConfidenceSlider_ValueChanged" />
                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="LEFT %" Style="{StaticResource LabelStyle}" />
                                                    <NumberBox x:Name="WeaponDetectionRegionXBox" Minimum="0" Maximum="95"
                                                               SmallChange="1" SpinButtonPlacementMode="Compact"
                                                               ValueChanged="WeaponDetectionRegion_ValueChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="TOP %" Style="{StaticResource LabelStyle}" />
                                                    <NumberBox x:Name="WeaponDetectionRegionYBox" Minimum="0" Maximum="95"
                                                               SmallChange="1" SpinButtonPlacementMode="Compact"
                                                               ValueChanged="WeaponDetectionRegion_ValueChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="6">
                                                    <TextBlock Text="WIDTH %" Style="{StaticResource LabelStyle}" />
                                                    <NumberBox x:Name="WeaponDetectionRegionWidthBox" Minimum="5" Maximum="100"
                                                               SmallChange="1" SpinButtonPlacementMode="Compact"
                                                               ValueChanged="WeaponDetectionRegion_ValueChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Spacing="6">
                                                    <TextBlock Text="HEIGHT %" Style="{StaticResource LabelStyle}" />
                                                    <NumberBox x:Name="WeaponDetectionRegionHeightBox" Minimum="10" Maximum="100"
                                                               SmallChange="1" SpinButtonPlacementMode="Compact"
                                                               ValueChanged="WeaponDetectionRegion_ValueChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="WeaponDetectionDetailText"
                                                       Text="Loadout OCR is off; the 1/2 slot shortcuts can still be used."
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock x:Name="WeaponRecognizedTextPreview" Text=""
                                                       FontFamily="Consolas" FontSize="10" Foreground="#606060"
                                                       TextTrimming="CharacterEllipsis" MaxLines="2" />
                                        </StackPanel>
                                        <Button x:Name="CaptureWeaponNowButton" Grid.Column="1"
                                                Content="Detect loadout now"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="CaptureWeaponNowButton_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Calibration -->
                    <ScrollViewer x:Name="CalibrationPage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1120" Padding="28,24,28,30" HorizontalAlignment="Center">
                            <Grid.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="14" />
                                </TransitionCollection>
                            </Grid.Transitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Calibration" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Tune sensitivity and the selected weapon without changing stock profile data. Screen resolution and FOV do not scale relative HID mouse movement."
                                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CalibrationActionStatusText"
                                               Text="Changes are saved and synchronized automatically."
                                               FontSize="10" Foreground="#666666" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button x:Name="UndoCalibrationButton" Content="Undo reset" IsEnabled="False"
                                            Click="UndoCalibrationButton_Click" />
                                    <Button Content="Reset calibration" Click="ResetCalibrationButton_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Input sensitivity" Style="{StaticResource SectionTitleStyle}" />

                                    <Grid ColumnDefinitions="150,*,100" ColumnSpacing="16">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Horizontal" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="In-game hip-fire value" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <Slider x:Name="HorizontalSensitivitySlider" Grid.Column="1"
                                                Minimum="1" Maximum="180" StepFrequency="0.5"
                                                ValueChanged="CalibrationSlider_ValueChanged" />
                                        <NumberBox x:Name="HorizontalSensitivityBox" Grid.Column="2"
                                                   Minimum="0.5" Maximum="180" SmallChange="0.5"
                                                   SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Calibration_ValueChanged" />
                                    </Grid>

                                    <Grid ColumnDefinitions="150,*,100" ColumnSpacing="16">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Vertical" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="In-game hip-fire value" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <Slider x:Name="VerticalSensitivitySlider" Grid.Column="1"
                                                Minimum="1" Maximum="180" StepFrequency="0.5"
                                                ValueChanged="CalibrationSlider_ValueChanged" />
                                        <NumberBox x:Name="VerticalSensitivityBox" Grid.Column="2"
                                                   Minimum="0.5" Maximum="180" SmallChange="0.5"
                                                   SpinButtonPlacementMode="Compact"
                                                   ValueChanged="Calibration_ValueChanged" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="MOUSE DPI" Style="{StaticResource LabelStyle}" />
                                            <NumberBox x:Name="MouseDpiBox" Minimum="100" Maximum="32000"
                                                       SmallChange="100" SpinButtonPlacementMode="Compact"
                                                       ValueChanged="Calibration_ValueChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="MULTIPLIER UNIT" Style="{StaticResource LabelStyle}" />
                                            <NumberBox x:Name="SensitivityMultiplierBox" Minimum="0.0001" Maximum="0.1"
                                                       SmallChange="0.0001" SpinButtonPlacementMode="Compact"
                                                       ValueChanged="Calibration_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="13">
                                        <TextBlock Text="Aim down sights" Style="{StaticResource SectionTitleStyle}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="MAGNIFICATION" Style="{StaticResource LabelStyle}" />
                                                <ComboBox x:Name="MagnificationSelector" HorizontalAlignment="Stretch"
                                                          SelectionChanged="MagnificationSelector_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="ADS SENSITIVITY" Style="{StaticResource LabelStyle}" />
                                                <NumberBox x:Name="AdsSensitivityBox" Minimum="1" Maximum="200"
                                                           SmallChange="1" SpinButtonPlacementMode="Compact"
                                                           ValueChanged="Calibration_ValueChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="OPTIC SELECTION" Style="{StaticResource LabelStyle}" />
                                                <TextBlock x:Name="AutomaticMagnificationStatusText"
                                                           Text="Automatic side-based default"
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AutomaticMagnificationToggle" Grid.Column="1"
                                                          IsOn="True"
                                                          OnContent="Automatic"
                                                          OffContent="Manual override"
                                                          Toggled="AutomaticMagnificationToggle_Toggled" />
                                        </Grid>
                                        <Border Padding="11" CornerRadius="7" Background="#0B0B0B">
                                            <TextBlock x:Name="CalibrationSummaryText"
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- Device -->
                    <ScrollViewer x:Name="DevicePage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1120" Padding="28,24,28,30" HorizontalAlignment="Center">
                            <Grid.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="14" />
                                </TransitionCollection>
                            </Grid.Transitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Hardware" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Manage the RP2040 or RP2350 connection and output safety state."
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ConnectSimulatorButton" Content="Use simulator"
                                            Click="ConnectSimulatorButton_Click"
                                            ToolTipService.ToolTip="Tests the full app configuration path without producing mouse input." />
                                    <Button x:Name="DeviceConnectButton" Content="Scan for device"
                                            Style="{StaticResource AccentButtonStyle}" Click="ConnectButton_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Width="42" Height="42" CornerRadius="9" Background="#171717">
                                        <FontIcon Glyph="&#xE88E;" FontSize="18" Foreground="#BEBEBE"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse x:Name="DevicePageConnectionDot" Width="7" Height="7"
                                                     Fill="#626262" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DevicePageConnectionTitle" Text="Device not connected"
                                                       FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock x:Name="DevicePageConnectionDetail"
                                                   Text="The app will verify the firmware handshake before enabling output."
                                                   Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="DevicePageArmToggle" Grid.Column="2" Header="ARM OUTPUT"
                                                  IsEnabled="False" Toggled="DevicePageArmToggle_Toggled" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="*,*" ColumnSpacing="14">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Safety behavior" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Output is sent only while the device is connected, the client is armed, and both aim + fire are physically held. Disarming always sends STOP."
                                                   Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Firmware link" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Serial discovery requires the project firmware handshake; unrelated serial devices are ignored."
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock x:Name="HardwareIdentityText"
                                                   Text="Hardware: waiting for firmware identity"
                                                   FontSize="11" Foreground="#A8A8A8" TextWrapping="Wrap" />
                                        <TextBlock x:Name="PhysicalMouseStatusText"
                                                   Text="Physical mouse: status will appear after the firmware handshake"
                                                   FontSize="11" Foreground="#A8A8A8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Validation and diagnostics" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="ConfigurationStatusText"
                                                   Text="Configuration is checked before every device synchronization."
                                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="DiagnosticCopyStatusText"
                                                   Text="Diagnostic reports contain settings summaries and recent events, never screenshots."
                                                   FontSize="10" Foreground="#666666" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="Validate now" Click="ValidateConfigurationButton_Click" />
                                        <Button Content="Copy diagnostic report"
                                                Click="CopyDiagnosticReportButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Installation -->
                    <ScrollViewer x:Name="InstallationPage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1120" Padding="28,24,28,30" HorizontalAlignment="Center">
                            <Grid.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="14" />
                                </TransitionCollection>
                            </Grid.Transitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Installation" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Get the firmware, Windows client, and hardware link ready in order."
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open full guide"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OpenInstallationGuide_Click" />
                            </Grid>

                            <Border Grid.Row="1" Margin="0,20,0,0" Padding="20" CornerRadius="10"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#171717" Offset="0" />
                                        <GradientStop Color="#0C0C0C" Offset="0.58" />
                                        <GradientStop Color="#171329" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid ColumnDefinitions="2*,3*" ColumnSpacing="26">
                                    <Image Source="ms-appx:///Assets/zerosense-wordmark.png"
                                           Height="164" Stretch="Uniform" Opacity="0.92" />
                                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                        <Border Padding="8,4" CornerRadius="5" Background="{StaticResource AccentSoftBrush}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="SETUP PATH" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="#C0B5FF" CharacterSpacing="110" />
                                        </Border>
                                        <TextBlock Text="Three components. One clean setup."
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="Download the release, flash the UF2 matching your board, then let ZeroSense verify the firmware handshake before arming output."
                                                   Style="{StaticResource MutedTextStyle}" MaxWidth="520"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="1" FontWeight="SemiBold" Foreground="#C5BAFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Flash firmware" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Choose the UF2 matching RP2040-Zero or RP2350-USB-C and copy it to RPI-RP2."
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="2" FontWeight="SemiBold" Foreground="#C5BAFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Install ZeroSense" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Download the Windows ZIP, verify SHA256SUMS.txt, extract every file, then run zerosense.exe."
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="3" FontWeight="SemiBold" Foreground="#C5BAFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Connect and verify" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Open zerosense.exe, scan for the board, select a loadout, then arm deliberately."
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Requirements" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Windows 10/11 x64 · USB data cable · RP2040-Zero or Waveshare RP2350-USB-C · no developer tools required"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock x:Name="InstallationStatusText"
                                                   Text="The full Markdown guide is included beside the published app."
                                                   FontSize="11" Foreground="#666666" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="Open latest release"
                                                Click="OpenLatestRelease_Click" />
                                        <Button Content="Installation guide"
                                                Click="OpenInstallationGuide_Click" />
                                        <Button Content="Troubleshooting"
                                                Click="OpenTroubleshootingGuide_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Application updates" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Checks the official GitHub release feed. Review the publisher and SHA-256 checksum before installing."
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock x:Name="UpdateStatusText" Text="Ready to check for updates."
                                                   FontSize="11" Foreground="#666666" />
                                    </StackPanel>
                                    <Button x:Name="CheckForUpdatesButton" Grid.Column="1"
                                            Content="Check for updates" VerticalAlignment="Center"
                                            Click="CheckForUpdatesButton_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Compact in-game overlay -->
        <Grid x:Name="CompactOverlayShell" Visibility="Collapsed" Padding="14" Background="#F0080808">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="28" Height="28" CornerRadius="6" Background="#080808"
                        BorderBrush="#292929" BorderThickness="1">
                    <Image Source="ms-appx:///Assets/zerosense-mark.png"
                           Width="25" Height="25" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ZEROSENSE OVERLAY" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" />
                    <TextBlock x:Name="OverlayShortcutText" Text="F8 to return" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Button x:Name="ExitOverlayButton" Grid.Column="2" Content="&#xE711;"
                        FontFamily="Segoe Fluent Icons" Width="32" Height="32" Padding="0"
                        Click="ExitOverlayButton_Click" />
            </Grid>

            <Border Grid.Row="1" Margin="0,13,0,0" Padding="12" CornerRadius="8" Background="#111111"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Ellipse x:Name="OverlayStatusDot" Width="7" Height="7" Fill="#626262"
                             VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="OverlayStatusText" Text="Device offline" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="OverlayDetectionText" Text="Detection disabled" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ToggleSwitch x:Name="OverlayArmToggle" Grid.Column="2" Header="ARM"
                                  IsEnabled="False" Toggled="OverlayArmToggle_Toggled" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,0" ColumnDefinitions="*,*" ColumnSpacing="9">
                <Border Padding="10" CornerRadius="7" Background="#0D0D0D"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="3">
                        <TextBlock Text="OPERATOR" Style="{StaticResource LabelStyle}" />
                        <TextBlock x:Name="OverlayOperatorText" Text="—" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="10" CornerRadius="7" Background="#0D0D0D"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="3">
                        <TextBlock Text="WEAPON" Style="{StaticResource LabelStyle}" />
                        <TextBlock x:Name="OverlayWeaponText" Text="—" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button Grid.Row="3" Margin="0,10,0,0" Content="Open full client"
                    Style="{StaticResource AccentButtonStyle}" Click="ExitOverlayButton_Click" />
        </Grid>
    </Grid>
</UserControl>
